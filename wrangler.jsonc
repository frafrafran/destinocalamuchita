// Cloudflare Worker for DestinoCalamuchita (Next.js through OpenNext). Deploy with `npm run cf:deploy`.
// Secrets are not here: set them with `npx wrangler secret put NAME` (see docs/GUIA-DE-USO.md, section 3).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "destinocalamuchita",
  "account_id": "4a990748c64002284447442eb4b169fc",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Static files built by Next.js (/_next/static, public/).
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Lets OpenNext call back into this Worker (required by the adapter).
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "destinocalamuchita" }],

  // PostgreSQL (Supabase, São Paulo) through Hyperdrive, query caching disabled so availability is
  // always current. `localConnectionString` is used by `npm run cf:preview`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b1d9577a7fb64f1e9379640ac0df6ece",
      "localConnectionString": "postgresql://remanso:remanso@localhost:5433/remanso",
    },
  ],
  // Property photos (MEDIA, served through /media) and payment receipts (RECEIPTS, private).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "destinocalamuchita-media" },
    { "binding": "RECEIPTS", "bucket_name": "destinocalamuchita-receipts" },
  ],
  // Image resizing for uploads and next/image.
  "images": { "binding": "IMAGES" },

  // Housekeeping every 15 minutes (cloudflare/worker.js → /api/cron).
  "triggers": { "crons": ["*/15 * * * *"] },

  // Non-secret settings. APP_URL must be the public address (workers.dev or your own domain).
  "vars": {
    "APP_URL": "https://destinocalamuchita.franciscoaybar2110.workers.dev",
    "STORAGE_DRIVER": "r2",
    // "console" writes emails to the Worker logs. Switch to "resend" (and set the RESEND_API_KEY
    // secret and EMAIL_FROM) once a domain is verified in Resend.
    "EMAIL_DRIVER": "console",
    "EMAIL_FROM": "DestinoCalamuchita <reservas@example.com>",
    "ICAL_SYNC_INTERVAL_MINUTES": "30",
    // Demonstration site: "fictional data" notice on every page and hidden from search engines.
    // Set to "false" before publishing real properties (and delete the DEMO_ACCESS_KEY secret).
    "DEMO_MODE": "true",
  },

  "observability": { "enabled": true },
  "upload_source_maps": true,
}
