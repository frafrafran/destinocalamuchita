# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Locally `npm run db:local` starts a server matching this URL.
# On Cloudflare the HYPERDRIVE binding is used instead (wrangler.jsonc).
DATABASE_URL="postgresql://remanso:remanso@localhost:5433/remanso"
# Public base URL of the site (used in emails, sitemap, iCal export links).
APP_URL="http://localhost:3000"
# Shared secret for /api/cron. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""
# Signs guest reservation links (min 32 chars). Changing it invalidates every link already emailed.
APP_SECRET=""

# ─── Storage: "local" (development), "r2" (Cloudflare bindings, set in wrangler.jsonc) or "s3" (any S3 API) ─
STORAGE_DRIVER="local"
S3_ENDPOINT=""                # e.g. https://<account>.r2.cloudflarestorage.com (empty for AWS)
S3_REGION="auto"
S3_BUCKET_PUBLIC=""           # bucket for property photos (public read)
S3_BUCKET_PRIVATE=""          # bucket for payment receipts (private)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""         # public URL of the photos bucket / CDN, e.g. https://media.example.com

# ─── Email: "console" (logs to terminal), "smtp" or "resend" ─────────────────
EMAIL_DRIVER="console"
EMAIL_FROM="DestinoCalamuchita <reservas@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# ─── Optional ────────────────────────────────────────────────────────────────
# Minutes between automatic iCal imports (Airbnb, Booking…). Default 30.
ICAL_SYNC_INTERVAL_MINUTES="30"

# ─── Demo seed (npm run db:seed) ─────────────────────────────────────────────
# Leave passwords empty to have random ones generated and printed once.
SEED_ADMIN_EMAIL="admin@destinocalamuchita.local"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""
# "false" for production: only the admin user, the amenity catalog and default rules (no fictional properties).
SEED_DEMO_DATA="true"
